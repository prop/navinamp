<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NaVinaMP entitlements (macOS distribution).

  The WKWebView JIT-compiles JavaScript, which hardened runtime (required
  for notarization) forbids by default — hence allow-jit. Everything else
  stays default-denied; NaVinaMP is not sandboxed (music-player file access
  + local HTTP server use would fight the sandbox).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
